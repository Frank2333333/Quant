{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "a-share-ma-screener",
  "main": "src/index.js",
  "compatibility_date": "2026-08-10",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "dotonly.xyz",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SCREEN_CACHE",
      "id": "30263c96b0db40ec9cad3da5ccc7b5db"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
